{
  "name": "prisma-airs-harness-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "npm run generate && docusaurus start",
    "generate": "node scripts/generate.mjs",
    "build": "npm run generate && docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "check": "npm run build && npm run typecheck && npm run test:browser"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/plugin-content-docs": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@docusaurus/theme-common": "3.10.1",
    "@docusaurus/theme-mermaid": "3.10.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2",
    "@playwright/test": "1.63.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "serialize-javascript": "7.1.2",
    "lodash-es": "4.18.1",
    "sockjs": {
      "uuid": "11.1.1"
    }
  }
}
